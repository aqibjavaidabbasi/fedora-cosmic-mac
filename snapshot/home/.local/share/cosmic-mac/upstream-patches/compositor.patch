+    /// cosmic-mac B3.2: this workspace as a `mac_spaces` snapshot entry. Windows get ids by
+    /// identity through `ids`; a Space owner that no longer exists gets an id no window has.
+    /// `recently_created` is filled in by the workspace set.
+    pub fn mac_space_info(
+        &self,
+        ids: &mut crate::shell::mac_spaces::IdentityMap<CosmicSurface>,
+        xdg_activation_state: &XdgActivationState,
+    ) -> crate::shell::mac_spaces::WorkspaceInfo {
+        use crate::shell::mac_spaces::{WindowInfo, WindowState, WorkspaceInfo};
+        let mut windows = Vec::new();
+        for mapped in self.mapped() {
+            let maximized = mapped.maximized_state.lock().unwrap().is_some();
+            for (surface, _) in mapped.windows() {
+                windows.push(WindowInfo {
+                    id: ids.id_of(&surface),
+                    state: WindowState { maximized, fullscreen: false, minimized: false },
+                });
+            }
+        }
+        for minimized in &self.minimized_windows {
+            for surface in minimized.windows() {
+                windows.push(WindowInfo {
+                    id: ids.id_of(&surface),
+                    state: WindowState { maximized: false, fullscreen: false, minimized: true },
+                });
+            }
+        }
+        for fullscreen in self.get_fullscreen_surfaces() {
+            windows.push(WindowInfo {
+                id: ids.id_of(&fullscreen.surface),
+                state: WindowState { maximized: false, fullscreen: true, minimized: false },
+            });
+        }
+        let space_owner = self.mac_space_owner.as_ref().map(|owner| match owner.upgrade() {
+            Some(surface) if surface.alive() => ids.id_of(&surface),
+            _ => ids.absent(),
+        });
+        WorkspaceInfo {
+            pinned: self.pinned,
+            windows,
+            has_activation_token: self.has_activation_token(xdg_activation_state),
+            recently_created: false,
+            space_owner,
+            tiling_enabled: self.tiling_enabled,
