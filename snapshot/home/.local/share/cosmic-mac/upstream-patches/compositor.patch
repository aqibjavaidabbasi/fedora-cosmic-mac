+    let output_loc = output.geometry().loc;
+    let zone = layer_map_for_output(output).non_exclusive_zone();
+    let x = (pointer.x as i32 - output_loc.x - size.w / 2)
+        .min(zone.loc.x + zone.size.w - size.w - 6)
+        .max(zone.loc.x + 6);
+    Some(Point::from((x, zone.loc.y + 6)))
