+        assert!(up.velocity_at(Duration::from_millis(30)) > 0.0);
+        // moving down toward 0: velocity negative early
+        let down = spring_with(1.0, 0.0, 0.0, 1.0, 800.0);
+        assert!(down.velocity_at(Duration::from_millis(30)) < 0.0);
