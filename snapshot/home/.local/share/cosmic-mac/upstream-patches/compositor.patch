+    let h = saved.size.h.min(zone.size.h);
+    let x = loc.x.clamp(zone.loc.x, zone.loc.x + zone.size.w - w);
+    let y = loc.y.clamp(zone.loc.y, zone.loc.y + zone.size.h - h);
+    Some(Rectangle::new((x, y).into(), (w, h).into()))
