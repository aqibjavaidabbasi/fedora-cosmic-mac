+    let app_id = data.lock().ok()?.app_id.clone()?;
+    if !MAC_BLUR_APPS.iter().any(|a| *a == app_id) {
+        return None;
+    }
+    let geometry = states
+        .cached_state
+        .get::<smithay::wayland::shell::xdg::SurfaceCachedState>()
+        .current()
+        .geometry;
+    geometry.filter(|g| !g.is_empty())
+}
