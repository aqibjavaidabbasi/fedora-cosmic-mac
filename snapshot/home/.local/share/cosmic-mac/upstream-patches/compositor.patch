+        let mut delta = 0.0;
+        while delta > -3.0 {
+            t.track(delta, -1.0, 3, &b);
+            let p = t.position(now);
+            assert!(p <= previous + 1e-12, "delta {delta}: {p} after {previous}");
+            previous = p;
