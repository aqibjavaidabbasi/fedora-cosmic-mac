+        let mut owner: Owner<()> = Owner::None;
+        owner.begin(2, false, &tuning(), ());
+        assert_eq!(owner.kind(), OwnerKind::Client);
+        assert_eq!(owner.kind(), OwnerKind::Client);
+    }
