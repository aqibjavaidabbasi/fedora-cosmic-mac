[Unit]
Description=Close apps left unfocused for a long time, to save battery (~/.config/cosmic-mac/auto-quit.conf)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/cosmic-mac-autoquit
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
